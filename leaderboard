/* ── Runtime ── */
let allData = null;

async function loadData() {
    document.getElementById('loadingState').style.display = 'block';
    try {
        if (USE_LIVE_DATA) {
            const res  = await fetch(APPSCRIPT_URL);
            allData    = await res.json();
        } else {
            allData = DEMO_DATA;
        }
        renderSchoolCards(allData.schools);
        updateHeroStats(allData.schools);
    } catch (err) {
        console.error(err);
        document.getElementById('loadingState').innerHTML = `
            <i class="fas fa-exclamation-circle" style="font-size:2rem;color:#ef4444;display:block;margin:0 auto 12px;"></i>
            <p style="color:#ef4444;">Could not load data. Check your AppScript URL.</p>`;
    } finally {
        document.getElementById('loadingState').style.display = 'none';
    }
}

function updateHeroStats(schools) {
    const total = schools.reduce((a, s) => a + (s.totalParticipants || 0), 0);
    document.getElementById('heroSchools').textContent      = schools.length;
    document.getElementById('heroParticipants').textContent = total.toLocaleString();
    document.getElementById('heroQuizzes').textContent      = schools.length;
}

const iconColors = ['','gold','silver','bronze'];
const rankLabels = ['🥇','🥈','🥉'];

function renderSchoolCards(schools) {
    const grid = document.getElementById('schoolsGrid');
    if (!schools || !schools.length) {
        grid.innerHTML = `<div class="no-data" style="grid-column:1/-1"><i class="fas fa-inbox"></i><p>No quiz results yet. Check back soon!</p></div>`;
        return;
    }
    grid.innerHTML = '';
    schools.forEach((school, idx) => {
        const colorClass = iconColors[idx] || '';
        const rankBadgeClass = idx < 3 ? `r${idx+1}` : 'rn';
        const rankDisplay = idx < 3 ? rankLabels[idx] : `#${idx+1}`;
        const card = document.createElement('div');
        card.className = 'school-card';
        card.style.animationDelay = (idx * 100) + 'ms';
        card.innerHTML = `
            <div class="card-top-bar"></div>
            <div class="card-body">
                <div class="rank-badge ${rankBadgeClass}">${rankDisplay}</div>
                <div class="school-card-header">
                    <div class="school-icon ${colorClass}"><i class="fas fa-school"></i></div>
                    <div>
                        <h3>${school.name}</h3>
                        <span class="date-chip"><i class="fas fa-calendar-alt"></i> ${school.date}</span>
                    </div>
                </div>
                <div class="card-stats">
                    <div class="c-stat"><div class="cv">${school.totalParticipants}</div><div class="cl">Participants</div></div>
                    <div class="c-stat"><div class="cv">${school.topScore}</div><div class="cl">Top Score</div></div>
                    <div class="c-stat"><div class="cv">${school.duration}</div><div class="cl">Duration</div></div>
                </div>
                <div class="winner-chip">
                    <i class="fas fa-trophy"></i>
                    <div>
                        <div class="wl">🏆 Winner</div>
                        <div class="wn">${school.winner.name} — ${school.winner.score} pts</div>
                    </div>
                </div>
                <button class="view-btn" onclick="openModal('${school.id}')">
                    <i class="fas fa-chart-bar"></i> View Full Leaderboard
                </button>
            </div>`;
        grid.appendChild(card);
    });
}

function openModal(schoolId) {
    const school = allData.schools.find(s => s.id === schoolId);
    if (!school) return;

    document.getElementById('mSchoolName').textContent   = school.name + ' — Quiz Results';
    document.getElementById('mDate').textContent         = school.date;
    document.getElementById('mParticipants').textContent = school.totalParticipants;
    document.getElementById('mAvgScore').textContent     = school.avgScore + '/'+school.topScore;
    document.getElementById('mTopScore').textContent     = school.topScore + ' pts';
    document.getElementById('mDuration').textContent     = school.duration;

    const maxScore = school.topScore;

    // Build modal body
    let html = `
        <!-- WINNER BANNER -->
        <div class="winner-banner">
            <div class="trophy-icon">🏆</div>
            <div class="winner-info">
                <h3>Quiz Winner</h3>
                <h2>${school.winner.name}</h2>
                <p>${school.winner.class} &nbsp;·&nbsp; Score: <strong>${school.winner.score}/${maxScore}</strong></p>
                <div class="winner-badges">
                    <span class="w-badge gold">🥇 1st Place</span>
                    ${school.runnerUp ? `<span class="w-badge silver">🥈 Runner Up: ${school.runnerUp.name} (${school.runnerUp.score} pts)</span>` : ''}
                </div>
            </div>
        </div>

        <!-- CONGRATS STRIP -->
        <div class="congrats-strip">
            <p>🎉 Congratulations to all participants of <strong>${school.name}</strong> for an outstanding performance!</p>
            <button class="share-btn" onclick="shareResult('${school.name}','${school.winner.name}')">
                <i class="fas fa-share-alt"></i> Share
            </button>
        </div>

        <!-- TOP 10 LEADERBOARD -->
        <div class="lb-section">
            <h3><i class="fas fa-list-ol"></i> Top 10 Leaderboard</h3>
            ${school.topTen && school.topTen.length ? `
            <table class="lb-table">
                <thead>
                    <tr>
                        <th>Rank</th>
                        <th>Participant</th>
                        <th>Score</th>
                        <th>Correct</th>
                        <th>Wrong</th>
                    </tr>
                </thead>
                <tbody>
                    ${school.topTen.map(p => {
                        const rankClass = p.rank <= 3 ? `p${p.rank}` : 'pn';
                        const rankEmoji = p.rank === 1 ? '🥇' : p.rank === 2 ? '🥈' : p.rank === 3 ? '🥉' : p.rank;
                        const pct = Math.round((p.score / maxScore) * 100);
                        return `<tr>
                            <td>
                                <div class="rank-cell">
                                    <div class="rank-num ${rankClass}">${rankEmoji}</div>
                                </div>
                            </td>
                            <td>
                                <div class="participant-name">${p.name}</div>
                                <div class="participant-school">${p.class}</div>
                            </td>
                            <td>
                                <div class="score-bar-wrap">
                                    <div class="score-bar-bg"><div class="score-bar-fill" style="width:${pct}%"></div></div>
                                    <span class="score-val">${p.score}</span>
                                </div>
                            </td>
                            <td style="color:#10b981;font-weight:600;">✓ ${p.correct}</td>
                            <td style="color:#ef4444;font-weight:600;">✗ ${p.wrong}</td>
                        </tr>`;
                    }).join('')}
                </tbody>
            </table>` : `<div class="no-data"><i class="fas fa-hourglass-half"></i><p>Leaderboard data not yet available for this school.</p></div>`}
        </div>

        <!-- QUICK STATS -->
        <div class="lb-section" style="padding-top:0;">
            <h3><i class="fas fa-info-circle"></i> Quiz Summary</h3>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;">
                <div class="c-stat" style="text-align:left;padding:14px 16px;">
                    <div class="cl" style="margin-bottom:4px;">📅 Date</div>
                    <div class="cv" style="font-size:.9rem;">${school.date}</div>
                </div>
                <div class="c-stat" style="text-align:left;padding:14px 16px;">
                    <div class="cl" style="margin-bottom:4px;">👥 Total Participants</div>
                    <div class="cv" style="font-size:.9rem;">${school.totalParticipants}</div>
                </div>
                <div class="c-stat" style="text-align:left;padding:14px 16px;">
                    <div class="cl" style="margin-bottom:4px;">📊 Average Score</div>
                    <div class="cv" style="font-size:.9rem;">${school.avgScore} / ${maxScore}</div>
                </div>
                <div class="c-stat" style="text-align:left;padding:14px 16px;">
                    <div class="cl" style="margin-bottom:4px;">⏱ Duration</div>
                    <div class="cv" style="font-size:.9rem;">${school.duration}</div>
                </div>
            </div>
        </div>`;

    document.getElementById('modalBody').innerHTML = html;
    document.getElementById('detailModal').classList.add('open');
    document.body.style.overflow = 'hidden';

    // Animate score bars after render
    setTimeout(() => {
        document.querySelectorAll('.score-bar-fill').forEach(bar => {
            const w = bar.style.width;
            bar.style.width = '0%';
            setTimeout(() => { bar.style.width = w; }, 50);
        });
    }, 100);
}

function closeModal() {
    document.getElementById('detailModal').classList.remove('open');
    document.body.style.overflow = '';
    document.getElementById('modalBody').innerHTML = '';
}

function closeModalOnOverlay(e) {
    if (e.target === document.getElementById('detailModal')) closeModal();
}

function shareResult(school, winner) {
    const text = `🏆 ${winner} won the Infoma Academy Quiz at ${school}! Check out the full leaderboard at infoma.in/leaderboard`;
    if (navigator.share) {
        navigator.share({ title: 'Infoma Academy Quiz Results', text, url: window.location.href });
    } else if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(() => alert('Result copied to clipboard!'));
    } else {
        window.open('https://wa.me/?text=' + encodeURIComponent(text), '_blank');
    }
}

document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

// Boot
loadData();
</script>
<script src="/social-links.js"></script>
