    var topTen = [];
    try {
      var topSheet = ss.getSheetByName(row[0]);
      if (topSheet) {
        var topData = topSheet.getDataRange().getValues();
        for (var j = 1; j < topData.length && j <= 10; j++) {
          topTen.push({
            rank:    topData[j][0],
            name:    topData[j][1],
            class:   topData[j][2],
            score:   topData[j][3],
            correct: topData[j][4],
            wrong:   topData[j][5]
          });
        }
      }
